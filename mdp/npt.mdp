; Martini 3 CGMD - NPT equilibration
; Template for a 50 ns equilibration.
; Validate thermostat/barostat settings for the exact Martini 3 version used.

integrator              = md
dt                      = 0.02
nsteps                  = 2500000

nstxout-compressed      = 5000
nstenergy               = 5000
nstlog                  = 5000

cutoff-scheme           = Verlet
nstlist                 = 20
coulombtype             = shift
rcoulomb                = 1.1
rvdw                    = 1.1
rvdw-switch             = 0.9

tcoupl                  = v-rescale
tc-grps                 = System
tau_t                   = 1.0
ref_t                   = 300

pcoupl                  = berendsen
pcoupltype              = isotropic
tau_p                   = 12.0
ref_p                   = 1.0
compressibility         = 3e-4

constraints             = none
pbc                     = xyz

gen_vel                 = yes
gen_temp                = 300
gen_seed                = -1
